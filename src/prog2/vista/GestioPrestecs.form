<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="prog2.vista.GestioPrestecs">
  <grid id="27dc6" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="6bad0" binding="panelGestioPrestecs" layout-manager="GridLayoutManager" row-count="5" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="2" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-4512352"/>
        </properties>
        <border type="none" title="Gestio Prestecs"/>
        <children>
          <component id="e7fcf" class="javax.swing.JButton" binding="btnAfegirPrestec">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-4487499"/>
              <foreground color="-16185079"/>
              <hideActionText value="true"/>
              <text value="Afegir Prestec"/>
            </properties>
          </component>
          <component id="2b1ac" class="javax.swing.JButton" binding="btnRetornarPrestec">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-4487499"/>
              <foreground color="-16185079"/>
              <text value="Retornar Prestec"/>
            </properties>
          </component>
          <scrollpane id="e213e" binding="scrollPane">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="256" height="207"/>
              </grid>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="2ebca" class="javax.swing.JList" binding="visualitzarPrestecs">
                <constraints/>
                <properties>
                  <background color="-4487499"/>
                </properties>
              </component>
            </children>
          </scrollpane>
          <component id="3155f" class="javax.swing.JCheckBox" binding="chkOnlyNoRetornats">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-4487499"/>
              <text value="visualtizar només prestecs no retornats"/>
            </properties>
          </component>
          <component id="9e9f1" class="javax.swing.JButton" binding="btnSortir">
            <constraints>
              <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-2614758"/>
              <text value="Sortir"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
