<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="prog2.vista.GestioUsuaris">
  <grid id="27dc6" binding="panelGestioUsuaris" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="15">
    <margin top="10" left="18" bottom="10" right="18"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties>
      <background color="-338065"/>
      <font name="Candara" size="17" style="1"/>
      <foreground color="-2104859"/>
      <preferredSize width="620" height="320"/>
    </properties>
    <border type="none"/>
    <children>
      <scrollpane id="98e8f">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="1" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="256" height="275"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="d3e20" class="javax.swing.JList" binding="listUsuaris">
            <constraints/>
            <properties>
              <background color="-2590"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <component id="da4ee" class="javax.swing.JButton" binding="btnAfegirUsuari">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <minimum-size width="158" height="30"/>
            <preferred-size width="158" height="30"/>
          </grid>
        </constraints>
        <properties>
          <background color="-19898"/>
          <font name="Candara" size="17" style="1"/>
          <text value="Afegir Usuari"/>
        </properties>
      </component>
      <component id="4e7a8" class="javax.swing.JButton" binding="btnSortirGestioUsuaris">
